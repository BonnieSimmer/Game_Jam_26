title: Shiekh_Khaled_stage0
position: 81,-352
---
// --- DECLARATIONS (Only run once by Yarn) ---
<<declare $Shiekh_Khaled_relationship = 0>>
<<declare $Shiekh_Khaled_progress = 0>>
<<declare $lightAdded = 0>>
<<declare $currentDay = 0>>
<<declare $wrongSalute = false>>

// --- DIALOGUE START ---
<<if $Shiekh_Khaled_progress == 0>>
    Old Khaled: ....... .......

    -> "slam alykom (peace be upon you)"
        <<jump stage0_bestResponse>>
    -> "...."
        <<jump stage0_neutralResponse>>
    -> "*wave and smile*"
        <<jump stage0_goodResponse>>
    -> "What is with the stony face old man"
        <<jump stage0_badResponse>>
    -> "Your beard looks like broom head"
        <<jump stage0_worstResponse>>
    
    // Conditional Choice
    <<if $wrongSalute == false>>
        -> "Hiii"
            <<jump stage0_outOfContext>>
    <<endif>>

<<elseif $Shiekh_Khaled_progress == 1>>
    // This plays if you talk to him again on the same day (or if logic fails)
    Old Khaled: ...... ....
<<endif>>
===

