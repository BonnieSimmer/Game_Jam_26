---

<<if $oldMan_stage == 1 && $currentDay>=1 >>
    <<if $relationship >= 10>>
        <<jump stage1_WarmWelcome>>
    <<elseif $relationship >= 5>>
        <<jump stage1_GoodWelcome>>
    <<elseif $relationship >= -5>>
        <<jump stage1_NeutralWelcome>>
    <<else>>
        <<jump stage1_ColdWelcome>>
    <<endif>>
<<endif>>
        
