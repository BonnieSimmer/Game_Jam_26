title: Shiekh_Khaled_stage1
position: 81,-352
---
// Check if it's the right stage and at least day 1
<<if $Shiekh_Khaled_progress >= 1>>
    
    // Branch based on Relationship Score
    <<if $Shiekh_Khaled_relationship >= 10>>
        <<jump stage1_WarmWelcome>>
    <<elseif $Shiekh_Khaled_relationship >= 5>>
        <<jump stage1_GoodWelcome>>
    <<elseif $Shiekh_Khaled_relationship >= -5>>
        <<jump stage1_NeutralWelcome>>
    <<else>>
        <<jump stage1_ColdWelcome>>
    <<endif>>

<<else>>
    // Fallback if accessed on Day 0 or wrong stage
    Old Khaled: ...I need some rest.
    <<npc_gesture Shiekh_Khaled dismiss>>
<<endif>>
===

